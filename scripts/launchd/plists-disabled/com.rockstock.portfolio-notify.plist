<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rockstock.portfolio-notify</string>

  <!-- 賠少 P0③（2026-06-14）：每日盤中跑持倉停損/出場檢查 → ntfy 推到手機。
       route 盤外自動 no-op（outside TW session window），所以多打幾次很便宜。
       時間=CST：09:05 開盤偵測、11:00/13:00 盤中、13:18+13:25 朱書執行窗（掛 13:25 市價單）。
       治「知道要停損但沒做」(3006 案例)。route 已含當日 symbol+action 去重。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/curl -fsS --max-time 90 -H 'Authorization: Bearer CRON_SECRET' http://localhost:3000/api/cron/portfolio-notify</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
