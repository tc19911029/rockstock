<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rockstock.scan-30m</string>

  <!--
    六條件(30分K) 開盤選股 — 用開盤第一根 30分K(09:30 收)掃六條件選當天名單。
    09:30 + 09:35(retry) 各觸發一次；route 內部 idempotent(同邊界只 append 一次)。
    OPTIONAL FALLBACK：instrumentation.ts 已於 09:30 一天一次觸發同一條 route(主要機制)。
    一般不必 load；prod dev-server 沒跑 instrumentation 時才需要：
      launchctl bootstrap gui/$(id -u) ~/Desktop/rockstock/scripts/launchd/plists/com.rockstock.scan-30m.plist
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-fsS</string>
    <string>--max-time</string>
    <string>110</string>
    <string>-H</string>
    <string>Authorization: Bearer CRON_SECRET</string>
    <string>http://localhost:3000/api/cron/scan-intraday-30m?market=TW</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>35</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/rockstock-scan-30m.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rockstock-scan-30m.err.log</string>
</dict>
</plist>
