<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rockstock.t1-fill-gaps</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/tc/.local/node-22/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd $HOME/Desktop/rockstock || exit 1; tw_status=0; cn_status=0; $HOME/.local/node-22/bin/node $HOME/.local/node-22/lib/node_modules/tsx/dist/cli.mjs scripts/t1-fill-gaps.ts --market TW --date auto --apply --concurrency 4 &gt;&gt; /tmp/rockstock-t1-fill-TW.log 2&gt;&amp;1 || tw_status=$?; $HOME/.local/node-22/bin/node $HOME/.local/node-22/lib/node_modules/tsx/dist/cli.mjs scripts/t1-fill-gaps.ts --market CN --date auto --apply --concurrency 4 &gt;&gt; /tmp/rockstock-t1-fill-CN.log 2&gt;&amp;1 || cn_status=$?; [ "$tw_status" -eq 0 ] &amp;&amp; [ "$cn_status" -eq 0 ]</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/rockstock-t1-fill.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rockstock-t1-fill.err.log</string>
</dict>
</plist>
